# Copy to .env.local for local runs. On Vercel set the same variables in Project Settings > Environment Variables.
# ngrok domain of Kaggle account A (4B models) and account B (2B models)
BACKEND_URL_A=https://first-name.ngrok-free.app
BACKEND_URL_B=https://second-name.ngrok-free.app
# Same value as APP_API_KEY in app/kaggle/accounts.local.json
APP_API_KEY=change-me
# Local UI work without Kaggle: run scripts/mock-backend.mjs and use instead
# BACKEND_URL_A=http://localhost:9000
# APP_API_KEY=dev-key
